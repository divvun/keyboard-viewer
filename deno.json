{
  "nodeModulesDir": "manual",
  "workspace": ["packages/keyboard"],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check && deno run --allow-read packages/keyboard/scripts/generate-css-module.ts --check",
    "dev": "vite",
    "prod": "deno serve --env-file=.env --allow-net --allow-read --allow-env --port 5173 _fresh/server.js",
    "ci": "rm -rf node_modules && deno clean && deno install",
    "build": "vite build",
    "start": "deno serve --env-file=.env -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.0",
    "vite": "npm:vite@^7.1.4",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.7",
    "happy-dom": "npm:happy-dom@^20.0.2"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  }
}
